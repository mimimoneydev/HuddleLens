# HuddleLens production server
PORT=4173
NODE_ENV=production
PUBLIC_APP_URL=https://huddlelens.example.com
HUDDLELENS_ALLOWED_ORIGINS=https://huddlelens.example.com,null

# AI routing: auto (Bedrock then OpenRouter), bedrock, or openrouter
AI_PROVIDER=auto

# Amazon Bedrock — credentials use the standard AWS SDK credential chain.
AWS_REGION=us-east-1
BEDROCK_DEFAULT_MODEL=global.amazon.nova-2-lite-v1:0
# Optional Bedrock Guardrail pair.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# Optional display values in USD per million tokens; keep current with AWS pricing.
BEDROCK_INPUT_PRICE_PER_MILLION=
BEDROCK_OUTPUT_PRICE_PER_MILLION=

# OpenRouter — never expose this key in src/, dist/, or Vega assets.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017
# Optional for testing against an OpenRouter-compatible gateway.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Sports events: mock | api-football | generic
SPORTS_PROVIDER=mock
SPORTS_POLL_MS=15000

# API-Football provider
API_FOOTBALL_KEY=
API_FOOTBALL_FIXTURE_ID=

# Generic provider contract: { match: {...}, events: [...] }
SPORTS_FEED_URL=
SPORTS_FEED_KEY=

# A licensed HLS/MP4 URL compatible with the target Fire TV WebView.
LICENSED_STREAM_URL=

# Used only when packaging file:// assets for the Vega emulator/device.
# Android-style emulators normally reach the host through 10.0.2.2.
HUDDLELENS_API_BASE_URL=http://10.0.2.2:4173
